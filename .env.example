# Copiar a .env y completar. .env NO se sube al repositorio.

# --- LLM ---------------------------------------------------------------
# Proveedor: anthropic | openai | ollama | none
#   none = sin LLM: keywords y etiquetas salen de términos TF-IDF (útil para probar sin API key)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento (solo Anthropic): low | medium | high
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ollama (modelo local, sin API key). Requiere: pip install -e ".[ollama]" y `ollama pull <modelo>`
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b
#   LLM_BASE_URL=http://localhost:11434   # solo si el servidor no está en el puerto por defecto
#   LLM_NUM_CTX=16384

# --- Datos -------------------------------------------------------------
# CSV o Parquet con columnas: id, created_at, author, author_followers, text, likes, retweets
# (topic / subtopic opcionales: etiquetas manuales usadas solo para evaluación)
DATA_PATH=data/sample/tweets.csv

# --- Detección de tópicos ----------------------------------------------
# kmeans (por defecto) | lda | bertopic (requiere: pip install -e ".[bertopic]")
TOPIC_MODEL=kmeans
# Solo para kmeans: tfidf (liviano) | sentence-transformers (requiere: pip install -e ".[embeddings]")
EMBEDDINGS=tfidf
# Máximo de mensajes dudosos (y outliers de BERTopic) que reclasifica el LLM por nivel
MAX_LLM_REASSIGN=120

# --- Reproducibilidad --------------------------------------------------
SEED=42
# Caché en disco de respuestas del LLM: re-ejecutar con los mismos datos no vuelve a llamar a la API
LLM_CACHE=true

# --- Trazas (opcional) -------------------------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=foco-social
